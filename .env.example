# Copy to .env to override defaults used by docker-compose.
# Every value below is optional — the stack starts with no .env at all.

# Port on which the playable application is published (nginx -> SPA + /api + /ws proxy).
APP_PORT=8080

# Port on which the backend is published directly (Swagger UI, raw REST checks).
API_PORT=8081

# Starting bonus balance granted to every seeded demo account.
DEMO_BONUS_BALANCE=5000

# Set to false to stop the simulated tournament opponents from moving.
SIMULATION_ENABLED=true
